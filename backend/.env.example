# Copy to backend/.env (git-ignored). Canonical env var names ONLY — never invent names.

# Neon Postgres connection string. If unset, the app falls back to a local
# SQLite file (backend/backend_dev.db) so the flow runs with no Neon.
# Example: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=

# LLM gateway keys. If ALL of these are unset, the app runs the deterministic
# fallback path (no model calls). No key ever reaches the browser.
LLM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Exact frontend origin allowed by CORS (no trailing slash). Never use "*".
ALLOWED_ORIGIN=http://localhost:3000

# Per-IP rate limit for cost-bearing endpoints (slowapi syntax, e.g. "20/minute").
RATE_LIMIT=20/minute
